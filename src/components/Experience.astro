---
import { experiences, education } from '../data/experience';
---

<section id="experiencia" class="container-section">
  <p class="section-label">Trajetória</p>
  <h2 class="section-title">Experiência & formação</h2>

  <div class="mt-10 grid lg:grid-cols-[3fr_2fr] gap-12 lg:gap-16 items-start">
    <!-- Experiência profissional -->
    <div>
      <h3 class="text-xs font-mono text-zinc-400 dark:text-zinc-600 uppercase tracking-widest mb-6">
        Profissional
      </h3>
      <div class="relative">
        <!-- Linha vertical da timeline -->
        <div
          class="absolute left-[7px] top-2 bottom-2 w-px bg-zinc-200 dark:bg-zinc-800"
          aria-hidden="true"
        >
        </div>

        <div class="flex flex-col gap-8">
          {
            experiences.map(({ period, role, company, location, area, highlights, current }) => (
              <div class="flex gap-6 pl-8 relative">
                <!-- Ponto da timeline -->
                <div
                  class:list={[
                    'absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full border-2 shrink-0',
                    current
                      ? 'bg-accent-500 border-accent-500 shadow-[0_0_0_3px] shadow-accent-500/20'
                      : 'bg-white dark:bg-zinc-950 border-zinc-300 dark:border-zinc-700',
                  ]}
                  aria-hidden="true"
                />

                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-1">
                    <h4 class="font-semibold text-zinc-900 dark:text-zinc-100">{role}</h4>
                    {current && (
                      <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-accent-500/10 text-accent-500 border border-accent-500/20">
                        atual
                      </span>
                    )}
                  </div>

                  <p class="text-sm font-medium text-zinc-600 dark:text-zinc-400 mb-0.5">
                    {company}
                  </p>

                  <p class="text-xs font-mono text-zinc-400 dark:text-zinc-600 mb-3">
                    {period} · {location}
                  </p>

                  {area && (
                    <p class="text-xs text-zinc-500 dark:text-zinc-500 italic mb-3">{area}</p>
                  )}

                  <ul class="flex flex-col gap-1.5">
                    {highlights.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-zinc-600 dark:text-zinc-400">
                        <span
                          class="w-1 h-1 rounded-full bg-accent-500/60 shrink-0 mt-2"
                          aria-hidden="true"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Formação -->
    <div>
      <h3 class="text-xs font-mono text-zinc-400 dark:text-zinc-600 uppercase tracking-widest mb-6">
        Formação
      </h3>

      <div class="flex flex-col gap-4">
        {
          education.map(({ period, degree, institution, current }) => (
            <div class="card card-hover p-5">
              <div class="flex items-start justify-between gap-2 mb-1">
                <p class="font-semibold text-zinc-900 dark:text-zinc-100 text-sm leading-snug">
                  {degree}
                </p>
                {current && (
                  <span class="shrink-0 text-xs font-mono px-1.5 py-0.5 rounded bg-accent-500/10 text-accent-500 border border-accent-500/20 mt-0.5">
                    cursando
                  </span>
                )}
              </div>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-1">{institution}</p>
              <p class="text-xs font-mono text-zinc-400 dark:text-zinc-600">{period}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
