---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class:list={[
    'card card-hover flex flex-col h-full group',
    featured && 'lg:flex-row',
  ]}
>
  <div
    class:list={[
      'p-6 sm:p-8 flex flex-col flex-1',
      featured && 'lg:py-10 lg:px-10',
    ]}
  >
    <!-- Header do card -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2 flex-wrap">
        {
          featured && (
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-accent-500/10 text-accent-500 border border-accent-500/20">
              destaque
            </span>
          )
        }
        <h3
          class:list={[
            'font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-accent-500 transition-colors duration-200 leading-snug',
            featured ? 'text-xl sm:text-2xl' : 'text-lg',
          ]}
        >
          {project.title}
        </h3>
      </div>

      {
        project.status === 'wip' && (
          <span class="shrink-0 text-xs font-mono px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 border border-amber-200/80 dark:border-amber-700/40 mt-0.5">
            em dev
          </span>
        )
      }
    </div>

    <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-6">
      {project.tagline}
    </p>

    <!-- Caso: Problema / Abordagem / Resultado -->
    <div
      class:list={[
        'flex flex-col flex-1 mb-6',
        featured ? 'lg:grid lg:grid-cols-3 lg:gap-6 space-y-4 lg:space-y-0' : 'space-y-4',
      ]}
    >
      {
        [
          { label: 'Problema', text: project.problem },
          { label: 'Abordagem', text: project.approach },
          { label: 'Resultado', text: project.result },
        ].map(({ label, text }) => (
          <div class:list={[featured && 'lg:border-l lg:border-zinc-100 lg:dark:border-zinc-800 lg:pl-6 lg:first:border-l-0 lg:first:pl-0']}>
            <p class="text-[10px] font-mono text-accent-500 uppercase tracking-widest mb-1">
              {label}
            </p>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{text}</p>
          </div>
        ))
      }
    </div>

    <!-- Stack pills -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {project.stack.map((tech) => <span class="skill-pill">{tech}</span>)}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-4 border-t border-zinc-100 dark:border-zinc-800 pt-4">
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-accent-500 dark:hover:text-accent-400 transition-colors duration-200"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        Ver no GitHub
        <svg
          class="w-3 h-3 opacity-50"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </a>

      {
        project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-accent-500 dark:hover:text-accent-400 transition-colors duration-200"
          >
            Demo ao vivo
            <svg
              class="w-3 h-3 opacity-50"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>
