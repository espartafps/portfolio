---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Felipe Silva — Analytics Engineer & Capital Markets',
  description =
    'Engenheiro que aprendeu o mercado de capitais por dentro e usa dados e IA para resolver problemas reais nesse domínio.',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://espartafps.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = `${siteUrl}${image}`;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Felipe Silva" />
    <meta
      name="keywords"
      content="analytics engineering, capital markets, data science, fundos de investimento, Python, SQL, AWS, Itaú, portfolio, Felipe Silva"
    />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (para preview bonito no LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Felipe Silva" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!--
      Inicialização do tema antes do primeiro paint.
      Evita o flash de tema errado (FOUC).
      Default: dark. Se o usuário selecionou light anteriormente, remove a classe.
    -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var html = document.documentElement;
        if (stored === 'light') {
          html.classList.remove('dark');
        } else {
          html.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body
    class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans antialiased transition-colors duration-300"
  >
    <slot />
  </body>
</html>
